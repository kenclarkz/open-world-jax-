pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.4, 0.6, 0.85, 1)
scaling_3d/scale=0.5
scaling_3d/mode=4
anti_aliasing/quality/msaa_3d=0
